{
  "name": "@port/ui",
  "version": "0.1.0",
  "description": "Port design system: tokens, theme presets, Port-drawn components and behaviour for Port Browser, Git, Terminal and Hub. Framework-agnostic, with optional React bindings.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/port.umd.js",
  "module": "./dist/port.mjs",
  "types": "./dist/port.d.ts",
  "exports": {
    ".": { "types": "./dist/port.d.ts", "import": "./dist/port.mjs", "require": "./dist/port.umd.js" },
    "./port.css": "./dist/port.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./fonts.css": "./dist/fonts.css",
    "./themes/*": "./dist/themes/*",
    "./tokens": "./dist/tokens.mjs",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.dtcg.json": "./dist/tokens.dtcg.json",
    "./presets.json": "./dist/presets.json",
    "./icons": "./dist/icons.mjs",
    "./icons/*": "./dist/icons/*",
    "./tailwind": "./dist/tailwind-preset.cjs",
    "./react": "./react/index.tsx"
  },
  "files": ["dist", "react", "docs", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "engines": { "node": ">=18" }
}
