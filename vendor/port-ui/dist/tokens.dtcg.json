{
  "$description": "Port tokens in W3C Design Tokens (DTCG) format. Colours carry light and dark in $extensions.",
  "color": {
    "ground": {
      "$type": "color",
      "$value": "#e6e2d9",
      "$description": "App frame and desktop ground behind windows; Spatial's dot grid sits on it.",
      "$extensions": {
        "port.modes": {
          "light": "#e6e2d9",
          "dark": "#0c0f10"
        }
      }
    },
    "surface-0": {
      "$type": "color",
      "$value": "#f1eee7",
      "$description": "Window body; the ground panels sit on.",
      "$extensions": {
        "port.modes": {
          "light": "#f1eee7",
          "dark": "#131719"
        }
      }
    },
    "surface-1": {
      "$type": "color",
      "$value": "#faf8f4",
      "$description": "Default panel surface: sidebars, lists, tables.",
      "$extensions": {
        "port.modes": {
          "light": "#faf8f4",
          "dark": "#1a1f21"
        }
      }
    },
    "surface-2": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Raised: popovers, the active tab, Atelier's lifted tiles.",
      "$extensions": {
        "port.modes": {
          "light": "#ffffff",
          "dark": "#222829"
        }
      }
    },
    "surface-sunk": {
      "$type": "color",
      "$value": "#e9e5dc",
      "$description": "Inset wells: address bar, terminal gutters, code blocks.",
      "$extensions": {
        "port.modes": {
          "light": "#e9e5dc",
          "dark": "#0f1213"
        }
      }
    },
    "line": {
      "$type": "color",
      "$value": "#d8d2c6",
      "$description": "Hairline dividers and panel borders.",
      "$extensions": {
        "port.modes": {
          "light": "#d8d2c6",
          "dark": "#2c3436"
        }
      }
    },
    "line-strong": {
      "$type": "color",
      "$value": "#8f877a",
      "$description": "Control borders and connectors that must read at 3:1.",
      "$extensions": {
        "port.modes": {
          "light": "#8f877a",
          "dark": "#6f7d80"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#1a1d1b",
      "$description": "Primary text on every surface.",
      "$extensions": {
        "port.modes": {
          "light": "#1a1d1b",
          "dark": "#eef0eb"
        }
      }
    },
    "ink-2": {
      "$type": "color",
      "$value": "#4a504b",
      "$description": "Secondary text and labels on surface-0/1/2.",
      "$extensions": {
        "port.modes": {
          "light": "#4a504b",
          "dark": "#b4bcb6"
        }
      }
    },
    "ink-3": {
      "$type": "color",
      "$value": "#646a65",
      "$description": "Metadata and timestamps on surface-0/1/2; never on tints.",
      "$extensions": {
        "port.modes": {
          "light": "#646a65",
          "dark": "#8f9893"
        }
      }
    },
    "focus": {
      "$type": "color",
      "$value": "#1f4fd6",
      "$description": "Keyboard focus ring: 2px solid, 2px offset. Reserved for focus only.",
      "$extensions": {
        "port.modes": {
          "light": "#1f4fd6",
          "dark": "#93b4ff"
        }
      }
    },
    "on-fill": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text and icons on solid hue fills (buttons, vivid bands).",
      "$extensions": {
        "port.modes": {
          "light": "#ffffff",
          "dark": "#0d1110"
        }
      }
    },
    "brand": {
      "$type": "color",
      "$value": "#24493d",
      "$description": "Port's brand: Hub identity, the launch CTA, the active workspace, the cover. A deep bottle-mineral, deliberately darker (light) and paler (dark) than success green so brand never reads as \"passed\". Fills take on-fill text.",
      "$extensions": {
        "port.modes": {
          "light": "#24493d",
          "dark": "#cbe7da"
        }
      }
    },
    "brand-tint": {
      "$type": "color",
      "$value": "#dde8e3",
      "$description": "Brand wash behind the Hub hero, the current workspace and brand-selected rows.",
      "$extensions": {
        "port.modes": {
          "light": "#dde8e3",
          "dark": "#1c2b26"
        }
      }
    },
    "brand-ink": {
      "$type": "color",
      "$value": "#1d3b31",
