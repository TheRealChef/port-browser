  "spacing": {
    "space-1": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Icon-to-badge nudge."
    },
    "space-2": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Inside chips; tree indent ticks."
    },
    "space-3": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Row vertical padding (compact)."
    },
    "space-4": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Control padding; gap in clusters."
    },
    "space-5": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Panel inner padding (compact)."
    },
    "space-6": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Panel inner padding (cozy); card gap."
    },
    "space-7": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Region gap; editorial blocks."
    },
    "space-8": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Hub section rhythm."
    }
  },
  "radius": {
    "radius-hair": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Spatial controls, kbd keys."
    },
    "radius-ctl": {
      "$type": "dimension",
      "$value": "9px",
      "$description": "Buttons, inputs, rows, tabs (Keystone). Drawn as a sharp squircle (corner-shape: squircle) where supported."
    },
    "radius-panel": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Panels and tiles; = radius-window minus the 6px island gap. Sharp squircle."
    },
    "radius-tab": {
      "$type": "dimension",
      "$value": "13px",
      "$description": "Top corners of the app tab and active tabs; bottom corners stay square where they meet the edge."
    },
    "radius-window": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Windows; outermost container. Sharp squircle."
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Status pills and counters only."
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "\"IBM Plex Sans\", system-ui, sans-serif"
    },
    "display": {
      "$type": "fontFamily",
      "$value": "\"IBM Plex Sans\", system-ui, sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "\"IBM Plex Mono\", ui-monospace, monospace"
    }
  },
  "motion": {
    "d1": {
      "$type": "duration",
      "$value": "90ms",
      "$description": "Press, hover."
    },
    "d2": {
      "$type": "duration",
      "$value": "160ms",
      "$description": "Colour, fades."
    },
    "d3": {
      "$type": "duration",
      "$value": "240ms",
      "$description": "Selection, chevrons."
    },
    "d4": {
      "$type": "duration",
      "$value": "380ms",
      "$description": "Panels, docking."
    },
    "e-out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.2,.8,.2,1)",
      "$description": "Default ease-out."
    },
    "e-spring": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.32,1.36,.52,1)",
      "$description": "Settles with at most ~8% overshoot."
    },
    "e-io": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(.6,0,.3,1)",
      "$description": "Ease-in-out for loops."
    }
  },
  "shadow": {
    "shadow-tile": {
      "$type": "shadow",
      "$value": "0 1px 0 rgba(255,255,255,0.8) inset, 0 1px 2px rgba(40,32,20,0.10), 0 4px 12px rgba(40,32,20,0.06)",
      "$extensions": {
        "port.modes": {
          "light": "0 1px 0 rgba(255,255,255,0.8) inset, 0 1px 2px rgba(40,32,20,0.10), 0 4px 12px rgba(40,32,20,0.06)",
          "dark": "0 1px 0 rgba(255,255,255,0.05) inset, 0 1px 2px rgba(0,0,0,0.5), 0 6px 16px rgba(0,0,0,0.35)"
        }
      }
    },
    "shadow-float": {
      "$type": "shadow",
      "$value": "0 10px 30px rgba(40,32,20,0.16), 0 2px 6px rgba(40,32,20,0.08)",
      "$extensions": {
        "port.modes": {
          "light": "0 10px 30px rgba(40,32,20,0.16), 0 2px 6px rgba(40,32,20,0.08)",
          "dark": "0 14px 40px rgba(0,0,0,0.55), 0 2px 6px rgba(0,0,0,0.4)"
        }
      }
    },
    "shadow-well": {
      "$type": "shadow",
      "$value": "inset 0 1px 2px rgba(40,32,20,0.12)",
      "$extensions": {
        "port.modes": {
          "light": "inset 0 1px 2px rgba(40,32,20,0.12)",
          "dark": "inset 0 1px 3px rgba(0,0,0,0.5)"
        }
      }
    }
  }
}