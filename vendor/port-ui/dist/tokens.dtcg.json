      "$extensions": {
        "port.modes": {
          "light": "#1d3b31",
          "dark": "#d9efe5"
        }
      }
    },
    "mineral": {
      "$type": "color",
      "$value": "#2c7656",
      "$description": "Success only: passed, done, added lines, connected. No longer the brand. Solid marks, rails, icons, fills with on-fill text.",
      "$extensions": {
        "port.modes": {
          "light": "#2c7656",
          "dark": "#62c196"
